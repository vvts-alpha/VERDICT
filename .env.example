# AMRAAM — environment variables
#
# Copy to `.env` (which is gitignored — it holds secrets). The CLI auto-loads
# `cwd/.env` at startup via a dependency-free loader; a value already set in the
# shell takes precedence over the file. Every var below is OPTIONAL — unset just
# disables that feature. Most also have an equivalent CLI flag.

# ── WebUI auth (`serve`) ─────────────────────────────────────────────────────
# Two roles gate the observability WebUI/API/WS. operator = full access
# (New/Resume/Stop + all mutations); viewer = read-only. Set neither and the
# WebUI runs unauthenticated — safe only on 127.0.0.1, NOT with --host 0.0.0.0.
AMRAAM_WEB_PASSWORD=            # operator password  (or serve --password <pw>)
AMRAAM_WEB_PASSWORD_VIEWER=     # viewer (read-only) password  (or serve --viewer-password <pw>)

# ── Browser (Playwright / chromium) ──────────────────────────────────────────
# Path to a chromium binary. If unset, run `npx playwright install chromium`, or
# pass --browser-path <bin>. In containers also add --no-sandbox.
VERITAS_BROWSER_PATH=          # e.g. /usr/bin/chromium

# ── Burp integration (all opt-in; unset = off, behaviour byte-identical) ──────
# Upstream proxy — route ALL http + browser traffic through Burp (also: --burp-proxy).
BURP_PROXY=                    # e.g. http://127.0.0.1:8080

# Burp REST API — active scanning (the `burp-scan` command / WebUI burp-scan).
BURP_API=                      # e.g. http://127.0.0.1:1337
BURP_API_KEY=                  # Burp REST API key
BURP_RESOURCE_POOL=            # optional: named resource pool to throttle the scan
BURP_SCAN_CONFIG_FILE=         # optional: scan configuration (path or Burp config name)
BURP_SESSION_CONFIG_FILE=      # optional: session-handling configuration

# Burp audit + Collaborator API — out-of-band confirmation (probe_oob) for BLIND
# SSRF / XXE / OS-command-injection via a DNS/HTTP callback.
BURP_AUDIT_API=                # e.g. http://127.0.0.1:8090
BURP_AUDIT_TOKEN=              # audit API token

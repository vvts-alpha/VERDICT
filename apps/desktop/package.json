{
  "name": "@veritas/desktop",
  "version": "2026.9.12",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "dist-renderer",
    "icons",
    "preload.cjs",
    "electron-builder.yml",
    "packaging/after-pack.cjs"
  ],
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "pnpm build:renderer && pnpm build:main",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "test": "node --import tsx --experimental-test-module-mocks --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts' 'packaging/*.test.cjs'",
    "start": "electron dist/main.js",
    "dev": "pnpm build && electron dist/main.js",
    "spike": "electron src/spike.mjs",
    "dist": "electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@veritas/cli": "workspace:*",
    "@veritas/core": "workspace:*",
    "@veritas/server": "workspace:*",
    "@veritas/webui": "workspace:*",
    "lucide-react": "1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

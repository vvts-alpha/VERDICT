{
  "name": "@veritas/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "dist-renderer",
    "preload.cjs",
    "electron-builder.yml"
  ],
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.build.json",
    "build": "pnpm build:renderer && pnpm build:main",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p renderer/tsconfig.json --noEmit",
    "start": "electron dist/main.js",
    "dev": "pnpm build && electron dist/main.js",
    "spike": "electron src/spike.mjs",
    "dist": "electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@veritas/cli": "workspace:*",
    "@veritas/core": "workspace:*",
    "@veritas/server": "workspace:*",
    "@veritas/webui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}

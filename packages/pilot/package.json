{
  "name": "@veritas/pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Claude 主導の自律エージェント: Claude が tool-use ループでブラウザ/HTTP/証拠ツールを操縦(DESIGN §7.2, Agent SDK + Max サブスク)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@veritas/core": "workspace:*",
    "@veritas/crawler": "workspace:*",
    "@veritas/llm": "workspace:*",
    "@veritas/scanner": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.169",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

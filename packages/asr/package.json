{
  "name": "@veritas/asr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ASR — Attack Surface Recon: wildcard -> discover assets -> map surface -> score attack targets -> hand off to pilot (see docs/ASR.md)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@veritas/core": "workspace:*",
    "@veritas/llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

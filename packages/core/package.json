{
  "name": "@veritas/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared contract types + AssessmentState SQLite store (DESIGN §4.1, §5, §6.7, §7.4)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./llm-context": {
      "types": "./dist/llm-context.d.ts",
      "default": "./dist/llm-context.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "tldts": "^7.4.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}

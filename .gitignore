# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# runtime artifacts (see DESIGN §10)
runs/
/runs-public/
browser-profiles/

# sqlite state stores
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 資格情報を含む実 manifest(templates/scope_manifest.example.json だけ残す)
scope_manifest.json
scope_manifest_*.json
scope_manifest.*.json
!scope_manifest.example.json
*.manifest.json

# Private presentation materials must not be committed
/decks/
vault.json
.env

# ターゲット別の作業ディレクトリ(実認証情報・実 manifest・実 run を含む — 絶対にコミットしない)
projects/

# pnpm プロジェクトなので npm の lock は混入物(コミットしない)
package-lock.json

# 事前取得 Cookie ファイル(セッション秘密 — 絶対にコミットしない)
cookies/
*.cookies
*.cookies.*
*cookie*.json
*cookie*.txt
*_cookie*.json

# Burp レポート XML(生 req/resp を含む秘匿。burp-import で取り込む作業ファイル)
burp-result.xml
*.burp.xml
# 持ち込みの Burp 作業ファイル(scan policy 等。operator 個別 → コミットしない)
ScanPolicy.json

# misc
.DS_Store
*.log
dist-renderer/

# Local release staging and installer outputs
/bundle/
/dist-windows/
/VERDICT-Setup-*.exe
/windows-exe-*.zip

# Benchmark publications are maintained in vvts-alpha/verdict-pub
/benchmarks/
/scripts/bench-*
/scripts/build-juice-shop.mjs
/scripts/build-xbow-bench.mjs
/scripts/export-static-ui.mjs
/assets/juice-shop-model-cost.png

# Publish only maintained documentation; keep internal notes local
/docs/*
!/docs/USAGE.md
!/docs/VULNERABILITIES.md
!/docs/WEBUI_CONVENTIONS.md
!/docs/RELEASING.md
!/docs/burp-audit-api.openapi.yaml

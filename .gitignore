# dependencies
node_modules/

# build output
dist/
*.tsbuildinfo

# runtime artifacts (see DESIGN §10)
runs/
browser-profiles/

# sqlite state stores
*.sqlite
*.sqlite-shm
*.sqlite-wal

# 資格情報を含む実 manifest(templates/scope_manifest.example.json だけ残す)
scope_manifest.json
scope_manifest_*.json
scope_manifest.*.json
!scope_manifest.example.json
*.manifest.json

# プレゼン deck の成果物(decks/generate_*_deck.py から再生成可能。バイナリは追跡しない)
decks/*.pptx
vault.json
.env

# ターゲット別の作業ディレクトリ(実認証情報・実 manifest・実 run を含む — 絶対にコミットしない)
projects/

# pnpm プロジェクトなので npm の lock は混入物(コミットしない)
package-lock.json

# 事前取得 Cookie ファイル(セッション秘密 — 絶対にコミットしない)
cookies/
*.cookies
*.cookies.*
*cookie*.json
*cookie*.txt
*_cookie*.json

# Burp レポート XML(生 req/resp を含む秘匿。burp-import で取り込む作業ファイル)
burp-result.xml
*.burp.xml
# 持ち込みの Burp 作業ファイル(scan policy 等。operator 個別 → コミットしない)
ScanPolicy.json

# misc
.DS_Store
*.log
